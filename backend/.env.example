# FinExplain Backend Configuration
# IMPORTANT: Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Environment: "development" or "production"
# In production, all critical API keys must be set or the app will not start.
ENVIRONMENT=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# LLM_PROVIDER: "gemini" (default) or "groq"
LLM_PROVIDER=gemini

# Google Gemini Configuration (Required when LLM_PROVIDER=gemini)
# Get key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Groq API Configuration (Optional alternative provider when LLM_PROVIDER=groq)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# Generic Model Override (Optional: overrides provider-specific model if set)
# LLM_MODEL=gemini-2.5-flash

# ==============================================================================
# Vector Database & Embeddings
# ==============================================================================
# Supabase Configuration (PostgreSQL + BM25 Sparse Search)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Pinecone Vector Database Configuration (Dense Vector Search)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=finexplain

# Hugging Face Configuration (for Dense Embeddings)
HUGGINGFACE_API_KEY=your-huggingface-api-key
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==============================================================================
# Storage & Cache
# ==============================================================================
# Redis Configuration (Optional: for response caching)
REDIS_URL=redis://localhost:6379/0

# Storage Bucket
STORAGE_BUCKET=loan_docs
