# FinExplain Backend Configuration
# IMPORTANT: Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Environment: "development" or "production"
# In production, all critical API keys must be set or the app will not start.
ENVIRONMENT=development

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8000

# ==============================================================================
# Authentication & Security (JWT & Google OAuth & Admin)
# ==============================================================================
# Dedicated Admin Credentials for Admin Panel (/app/admin)
ADMIN_EMAIL=admin@finexplain.com
ADMIN_PS=your_secure_admin_password

# Secret key used to sign JWT access tokens (generate a secure random 32+ char string in production)
JWT_SECRET_KEY=your_super_secret_jwt_key_here_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Client ID (from Google Cloud Console: https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ==============================================================================
# Google Gemini LLM Configuration
# ==============================================================================
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-light

# ==============================================================================
# Vector Database & Embeddings
# ==============================================================================
# Supabase Configuration (PostgreSQL + BM25 Sparse Search)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-key
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Pinecone Vector Database Configuration (Dense Vector Search)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX_NAME=finexplain

# Hugging Face Configuration (for Dense Embeddings)
HUGGINGFACE_API_KEY=your-huggingface-api-key
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==============================================================================
# Storage & Cache
# ==============================================================================
# Redis Configuration (Optional: for response caching)
REDIS_URL=redis://localhost:6379/0

# Storage Bucket
STORAGE_BUCKET=loan_docs
